# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Default embedding model for RAG (must be available in Ollama)
EMBED_MODEL=nomic-embed-text

# Default judge model for evaluations (leave blank to auto-select first available)
JUDGE_MODEL=

# Path for the persistent knowledge store JSON file
KNOWLEDGE_STORE_PATH=.foundry_knowledge.json
